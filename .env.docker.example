NODE_ENV=production

##
PORT=3000

## Database Connection Configuration
### Privileged Migration Connection (Database Owner / Superuser identity - used by Drizzle Kit migrations)
PG_MIGRATION_PROD_URL=postgresql://postgres:your_postgres_password@multi-tenant-db:5432/tenant
PG_MIGRATION_DEV_URL=postgresql://postgres:1234@localhost:5433/tenant
PG_MIGRATION_TEST_URL=postgresql://postgres:1234@localhost:5433/tenant

### Restricted Application Runtime Connection (app_runtime identity - used by Express API)
PG_APP_PROD_URL=postgresql://app_runtime:your_app_password@multi-tenant-db:5432/tenant
PG_APP_DEV_URL=postgresql://app_runtime:app_password@localhost:5433/tenant
PG_APP_TEST_URL=postgresql://app_runtime:app_password@localhost:5433/tenant

### Legacy Fallback Connection
PG_DATABASE_PROD_URL=postgresql://postgres:1234@multi-tenant-db:5432/tenant
PG_DATABASE_DEV_URL=postgresql://postgres:1234@localhost:5433/tenant
PG_DATABASE_TEST_URL=postgresql://postgres:1234@localhost:5433/tenant
##
DB_SSL=false
PG_APP_PASSWORD=

## REDIS
REDIS_PROD_URL=
REDIS_DEV_URL=
REDIS_TEST_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

## LOG LEVELS
# {  error: 0, warn: 1, info: 2, http: 3, verbose: 4, debug: 5, silly: 6 }
LOG_LEVEL= http
SOURCE_TOKEN=
INGESTING_HOST=

## API BASEURL
API_BASEURL=http://localhost:3000/api/v1

## JWT SECRET
JWT_SECRET=qwerty