meta {
  name: Register Organization
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "organizationName": "Acme Corp",
    "email": "alice@acme.corp",
    "password": "password123"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

docs {
  Registers a new organization along with its first user atomically.
  
  If the `organizationSlug` is omitted from the request body, it will be automatically generated from the `organizationName`.
  
  ### Success Response
  ```json
  {
    "success": true,
    "message": "Organization registered successfully",
    "data": {
      "organization": {
        "id": "uuid",
        "name": "Acme Corp",
        "slug": "acme-corp"
      },
      "user": {
        "id": "uuid",
        "email": "alice@acme.corp"
      }
    },
    "meta": {
      "correlationId": "uuid"
    }
  }
  ```
  
  ### Error Response (Conflict)
  ```json
  {
    "success": false,
    "error": {
      "code": "CONFLICT",
      "message": "Organization slug or email already exists"
    }
  }
  ```
  
  ### Error Response (Validation Failure)
  ```json
  {
    "success": false,
    "error": {
      "code": "VALIDATION_ERROR",
      "message": "Invalid input",
      "details": [
        {
          "field": "body.password",
          "message": "Password must be at least 8 characters"
        }
      ]
    }
  }
  ```
}
