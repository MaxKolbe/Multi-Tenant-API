meta {
  name: Login User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "slug": "acme-corp",
    "email": "alice@acme.corp",
    "password": "password123"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

docs {
  Authenticates a user via their organization's slug, email, and password.
  Returns a JWT token to be used for subsequent requests.
  
  ### Success Response
  ```json
  {
    "success": true,
    "message": "Login successful",
    "data": {
      "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
      "user": {
        "id": "uuid",
        "email": "alice@acme.corp",
        "orgId": "uuid"
      }
    },
    "meta": {
      "correlationId": "uuid"
    }
  }
  ```
  
  ### Error Response (Invalid Credentials)
  Generic response to prevent leaking existence of emails, slugs, or valid passwords.
  ```json
  {
    "success": false,
    "error": {
      "code": "UNAUTHORIZED",
      "message": "Invalid credentials"
    }
  }
  ```
  
  ### Error Response (Validation Failure)
  ```json
  {
    "success": false,
    "error": {
      "code": "VALIDATION_ERROR",
      "message": "Invalid input",
      "details": [
        {
          "field": "body.password",
          "message": "Password is required"
        }
      ]
    }
  }
  ```
}
