meta {
  name: Create Task
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/tasks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "title": "New Task",
    "description": "Optional description",
    "status": "pending"
  }
}

docs {
  Creates a new task scoped to the authenticated user's organization.
  The `orgId` and `createdBy` fields are automatically assigned based on the verified JWT.

  ### Success Response
  ```json
  {
    "success": true,
    "message": "Task created successfully",
    "data": {
      "id": "uuid",
      "orgId": "uuid",
      "createdBy": "uuid",
      "title": "New Task",
      "description": "Optional description",
      "status": "pending",
      "createdAt": "date-time",
      "updatedAt": "date-time",
      "deletedAt": null
    },
    "meta": {
      "correlationId": "uuid"
    }
  }
  ```
}
