# Don't add this in hosting service
# development || production || test
NODE_ENV=development

##
PORT=3000

##
### The API container should connect to PostgreSQL using the Compose service name, not localhost
PG_DATABASE_PROD_URL=postgresql://postgres:1234@multi-tenant-db:5432/tenant
PG_DATABASE_DEV_URL=postgresql://postgres:1234@localhost:5433/tenant
PG_DATABASE_TEST_URL=postgresql://postgres:1234@localhost:5433/tenant
##
DB_SSL=false

## REDIS
REDIS_PROD_URL=
REDIS_DEV_URL=
REDIS_TEST_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

## LOG LEVELS
# {  error: 0, warn: 1, info: 2, http: 3, verbose: 4, debug: 5, silly: 6 }
LOG_LEVEL= http
SOURCE_TOKEN=
INGESTING_HOST=

## API BASEURL
API_BASEURL=http://localhost:3000/api/v1

## JWT SECRET
JWT_SECRET=qwerty