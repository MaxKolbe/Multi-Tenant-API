{
  "name": "multi-tenant-api",
  "version": "1.0.0",
  "packageManager": "npm@11.18.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npm install --include=dev && npx tsc",
    "start": "node dist/index.js",
    "dev:start": "node --env-file=.env dist/index.js",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "watch": "tsc -w",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env src/scripts/seed.ts",
    "db:seed:ci": "tsx src/scripts/seed.ts", 
    "db:gen-mig": "drizzle-kit generate && drizzle-kit migrate",
    "test": "vitest run --config src/configs/vitest.config.ts",
    "test:watch": "vitest --config src/configs/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config src/configs/vitest.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxKolbe/ts-node-template.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/MaxKolbe/ts-node-template/issues"
  },
  "homepage": "https://github.com/MaxKolbe/ts-node-template#readme",
  "dependencies": {
    "@logtail/node": "^0.5.8",
    "@logtail/winston": "^0.5.8",
    "cors": "2.8.6",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "pg": "8.20.0",
    "tsx": "4.21.0",
    "winston": "3.19.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "25.6.2",
    "@types/pg": "8.20.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  }
}
